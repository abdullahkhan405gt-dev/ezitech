#!/usr/bin/env python3
"""Evaluate a consultation summariser for accuracy and hallucinations. One file, no install.

Usage:
    python evaluate.py                    # baseline rule-based summariser (should PASS)
    python evaluate.py --backend bad      # deliberately hallucinating fake (should FAIL)
    python evaluate.py --backend claude   # real model (pip install anthropic + ANTHROPIC_API_KEY)

Checks per transcript:
  schema        all required JSON keys are present
  refusal       fields the transcript never states are exactly "NOT_STATED"
  accuracy      fields the transcript does state contain the expected text
  hallucination (a) no forbidden/trap terms appear in the output
                (b) every long word (6+ letters) in the output also appears in the transcript

Writes results/latest_results.json and appends to results/eval_log.txt.
Exit code is 0 if everything passes, 1 otherwise.

File layout:  1. test set   2. summariser backends   3. scoring and reporting
"""
import argparse
import datetime
import json
import os
import pathlib
import re
import sys

HERE = pathlib.Path(__file__).resolve().parent
FIELDS = ["chief_complaint", "duration", "medications", "allergies", "diagnosis", "plan"]
NOT_STATED = "NOT_STATED"

# =====================================================================
# 1. TEST SET  (add cases here: lines, expected, expected_missing, forbidden)
