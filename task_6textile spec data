# =====================================================================
# BUILD ONE ENTRY
# =====================================================================
def composition_text(breakdown):
    """[("Polyester", 65), ("Cotton", 35)] -> '65% Polyester, 35% Cotton'"""
    return ", ".join(f"{pct}% {fibre}" for fibre, pct in breakdown)


def category_of(breakdown):
    if len(breakdown) > 1:
        return "blend"
    return CATEGORY_OF_FIBRE[breakdown[0][0]]


def snippet_text(e):
    """One plain-English paragraph. The search tool will index and quote this."""
    parts = [
        f"{e['name']} ({e['id']}).",
        f"Composition: {e['composition']}.",
        f"Weight {e['weight_gsm']} gsm, width {e['width_cm']} cm.",
        f"Construction: {e['construction']}.",
        f"Finish: {e['finish']}.",
        f"Care: {'; '.join(e['care'])}.",
        f"Origin: {e['origin']}.",
        f"Certifications: {', '.join(e['certifications']) if e['certifications'] else 'none listed'}.",
    ]
    if e["notes"]:
        parts.append(f"Note: {e['notes']}")
    return " ".join(parts)


def build_entry(number, raw):
    entry = {
        "id": f"IW-FAB-{number:03d}",
        "name": raw["name"],
        "category": category_of(raw["breakdown"]),
        "composition": composition_text(raw["breakdown"]),
        "composition_breakdown": [{"fibre": f, "percent": p} for f, p in raw["breakdown"]],
        "weight_gsm": raw["weight_gsm"],
        "width_cm": raw["width_cm"],
        "construction": raw["construction"],
        "finish": raw["finish"],
        "care": list(raw["care"]),
        "origin": raw["origin"],
        "certifications": list(raw["certifications"]),
        "notes": raw["notes"],
        "source": f"Sample spec sheet IW-FAB-{number:03d}",
    }
    entry["text"] = snippet_text(entry)
    return entry


# =====================================================================
# CHECKS (the script refuses to save data that fails any of these)
# =====================================================================
REQUIRED = ["id", "name", "category", "composition", "care", "origin", "source", "text"]


def validate(entries):
    problems = []
    if not 20 <= len(entries) <= 30:
        problems.append(f"expected 20-30 entries, found {len(entries)}")
    for field in ("id", "name"):
        values = [e[field] for e in entries]
        dupes = sorted({v for v in values if values.count(v) > 1})
        if dupes:
            problems.append(f"duplicate {field}: {dupes}")
    for e in entries:
        label = e.get("id", "?")
        for field in REQUIRED:
            if not e.get(field):
                problems.append(f"{label}: '{field}' is empty")
        total = sum(b["percent"] for b in e["composition_breakdown"])
        if total != 100:
            problems.append(f"{label}: composition adds up to {total}%, not 100%")
        if e["name"] not in e["text"] or e["composition"] not in e["text"]:
            problems.append(f"{label}: text snippet is missing the name or composition")
    return problems


# =====================================================================
# MAIN
# =====================================================================
def main():
    ap = argparse.ArgumentParser(description="Generate the Indus Weaves sample fabric-spec JSON.")
    ap.add_argument("--out", default=str(DEFAULT_OUT), help="output file (default: data/fabric_specs.json)")
    args = ap.parse_args()

    entries = [build_entry(i, raw) for i, raw in enumerate(FABRICS, start=1)]

    problems = validate(entries)
    if problems:
        print("NOT SAVED. Fix these problems in FABRICS first:")
        for p in problems:
            print("  -", p)
        sys.exit(1)

    out = pathlib.Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(entries, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    print(f"Saved {len(entries)} fabric specs to {out}\n")
    print(f"{'ID':<12}{'Name':<34}Composition")
    for e in entries:
        print(f"{e['id']:<12}{e['name']:<34}{e['composition']}")
    print("\nAll checks passed. (Synthetic sample data - not real specifications.)")


if __name__ == "__main__":
    main()
