                  "Does the merino wool twill have a certification?", "What is the capital of France?"]


def main():
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")

    ap = argparse.ArgumentParser(description="Answer questions about Indus Weaves fabric specs, with sources.")
    ap.add_argument("--db-dir", default=str(vs.DEFAULT_DB_DIR), help="vector store folder (default: chroma_db/)")
    sub = ap.add_subparsers(dest="cmd")
    ask = sub.add_parser("ask", help="ask one question")
    ask.add_argument("question")
    ask.add_argument("--mode", choices=["template", "llm"], default=os.getenv("ANSWER_MODE", "template"),
                     help="template (default, no LLM) or llm (free LLM, see README)")
    ask.add_argument("--min-score", type=float, default=None, help=f"weakest match we still answer from (default {MIN_SCORE})")
    ask.add_argument("-v", "--verbose", action="store_true", help="show the chunks and scores used")
    sub.add_parser("test", help="run the built-in checks")
    sub.add_parser("calibrate", help="help choose the 'too weak' cut-off using your real model")
    args = ap.parse_args()

    try:
        if args.cmd == "test":
            sys.exit(run_tests())
        elif args.cmd == "calibrate":
            run_calibrate(args.db_dir)
        elif args.cmd == "ask":
            result = answer_question(args.question, mode=args.mode, min_score=args.min_score, db_dir=args.db_dir)
            print("\n" + format_answer(result))
            if args.verbose:
                print(f"\n[mode: {result['mode']} | best match score: {result['top_score']} | chunks used: {len(result['chunks'])}]")
                for h in result["chunks"]:
                    print(f"  {h['score']:.3f}  [{h['fabric_id']} | {h['section']}]  {h['text']}")
        else:  # no command: run the demo questions
            embedder = vs.Embedder()
            for q in DEMO_QUESTIONS:
                print(f"\nQ: {q}")
                print("A: " + format_answer(answer_question(q, db_dir=args.db_dir, embedder=embedder)).replace("\n", "\n   "))
    except (vs.SetupError, EngineError) as e:
        sys.exit(f"\nError: {e}")


if __name__ == "__main__":
    main()
