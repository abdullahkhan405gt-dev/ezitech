def build_cases():
    """Turn the CASES block into the entries written to the JSON file (adds the IDs)."""
    return [
        {
            "id": f"SR-{i:03d}",
            "category": c["category"],
            "question": c["question"].strip(),
            "expected_answer": c["answer"].strip(),
            "key_facts": list(c["key_facts"]),
        }
        for i, c in enumerate(CASES, start=1)
    ]


def validate(entries):
    """Return a list of problems (empty list = the data is fine)."""
    problems = []
    if not isinstance(entries, list):
        return ["the file must contain a list of test cases"]
    if not MIN_CASES <= len(entries) <= MAX_CASES:
        problems.append(f"expected {MIN_CASES}-{MAX_CASES} test cases, found {len(entries)}")
    for field in ("id", "question"):
        values = [e.get(field) for e in entries if isinstance(e, dict)]
        if len(set(values)) != len(values):
            problems.append(f"duplicate {field} values")
    for n, e in enumerate(entries, start=1):
        if not isinstance(e, dict):
            problems.append(f"entry {n}: not an object")
            continue
        label = e.get("id") or f"entry {n}"
        for field in ("id", "question", "expected_answer"):
            if not isinstance(e.get(field), str) or not e[field].strip():
                problems.append(f"{label}: '{field}' is missing or empty")
        if e.get("category") not in CATEGORIES:
            problems.append(f"{label}: category '{e.get('category')}' is not one of {CATEGORIES}")
        question, answer = e.get("question") or "", e.get("expected_answer") or ""
        if question and not question.rstrip().endswith("?"):
            problems.append(f"{label}: the question should end with '?'")
        if len(answer) > MAX_ANSWER_CHARS:
            problems.append(f"{label}: the answer is {len(answer)} characters (limit {MAX_ANSWER_CHARS})")
        facts = e.get("key_facts")
        if not isinstance(facts, list) or not facts or not all(isinstance(f, str) and f.strip() for f in facts):
            problems.append(f"{label}: 'key_facts' must be a list with at least one phrase")
        else:
            for fact in facts:
                if fact.lower() not in answer.lower():
                    problems.append(f"{label}: key fact '{fact}' does not appear word for word in the answer")
    return problems


def print_summary(entries):
    counts = {}
    for e in entries:
        counts[e["category"]] = counts.get(e["category"], 0) + 1
    print(f"{len(entries)} test cases:")
    for category in CATEGORIES:
        if category in counts:
            print(f"  {category:<13} {counts[category]}")
    print("\nFirst three:")
    for e in entries[:3]:
        print(f"  {e['id']}  Q: {e['question']}\n          A: {e['expected_answer']}")


def main():
    ap = argparse.ArgumentParser(description="Write and check test_cases.json for the Spice Route evaluation.")
    ap.add_argument("--out", default=str(DEFAULT_OUT), help="file to write or check (default: test_cases.json)")
    ap.add_argument("--check", action="store_true", help="only check an existing file, do not write")
    args = ap.parse_args()
    out = pathlib.Path(args.out)

    if args.check:
        if not out.exists():
            sys.exit(f"{out} not found. Run 'python generate_test_cases.py' first.")
        try:
            entries = json.loads(out.read_text(encoding="utf-8"))
        except ValueError as e:
            sys.exit(f"{out} is not valid JSON: {e}")
    else:
        entries = build_cases()

    problems = validate(entries)
    if problems:
        print("The test cases have problems, so nothing was written:" if not args.check else
              f"{out} has problems:")
        for p in problems:
            print("  -", p)
        sys.exit(1)

    if not args.check:
        out.write_text(json.dumps(entries, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"Saved {len(entries)} test cases to {out}\n")
    print_summary(entries)
    print("\nAll checks passed. (Sample restaurant facts: replace with Spice Route's real policies.)")


if __name__ == "__main__":
    main()
