EXAMPLE_QUESTIONS = ["How do I wash the linen blend?", "What is the composition of silk twill?",
                     "Which fabric is dry clean only?", "Does the merino wool twill have a certification?"]
_ENGINE = {}                      # the model is loaded once and shared by every visitor
_ENGINE_LOCK = threading.Lock()


def get_web_embedder(db_dir=DEFAULT_DB_DIR):
    """Load the embedding model once. Build the vector store first if it is missing or out of date."""
    with _ENGINE_LOCK:
        if "embedder" not in _ENGINE:
            embedder = Embedder()
            specs = load_specs()
            try:
                collection = open_collection(db_dir)
                up_to_date = (collection.count() == 3 * len(specs)
                              and (collection.metadata or {}).get("embedding_model") == embedder.name)
            except SetupError:
                up_to_date = False
            if not up_to_date:
                build_store(db_dir, embedder=embedder, specs=specs)
            _ENGINE["embedder"] = embedder
        return _ENGINE["embedder"]


def _md(text):
    """Make plain text safe to show as markdown (keeps [IW-FAB-015] and line breaks as written)."""
    return text.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]").replace("\n", "  \n")


def web_app():
    """The web page: a text box, and the answer with its sources below it."""
    import streamlit as st

    st.set_page_config(page_title="Indus Weaves Spec Search", page_icon="\U0001F9F5")
    st.title("Indus Weaves Spec Search")
    st.caption("Ask about fabric composition, care or origin. Every answer shows the spec entry it came from.")

    try:
        with st.spinner("Starting up: loading the search model and the vector store (the first start can take a minute)..."):
            embedder = get_web_embedder()
    except SetupError as e:
        st.error(str(e))
        st.stop()

    st.session_state.setdefault("question", "")

    def use_example(q):
        st.session_state.question = q
        st.session_state.run_example = True

    with st.form("ask"):
        st.text_input("Your question", key="question", placeholder="e.g. How do I wash the linen blend?")
        submitted = st.form_submit_button("Ask")
    st.caption("Try an example:")
    for col, q in zip(st.columns(2), EXAMPLE_QUESTIONS[:2]):
        col.button(q, on_click=use_example, args=(q,), key="ex_" + q, use_container_width=True)
    for col, q in zip(st.columns(2), EXAMPLE_QUESTIONS[2:]):
        col.button(q, on_click=use_example, args=(q,), key="ex_" + q, use_container_width=True)

    question = st.session_state.question.strip()
    run = submitted or st.session_state.pop("run_example", False)
    if run and not question:
        st.info("Type a question first.")
    elif run:
        mode = "llm" if os.getenv("LLM_BASE_URL") else "template"  # an LLM is used only if one is configured
        try:
            result = answer_question(question, mode=mode, db_dir=DEFAULT_DB_DIR, embedder=embedder)
        except (SetupError, EngineError) as e:
            st.error(f"Something went wrong: {e}")
            st.stop()
        if not result["sources"]:
            st.warning(result["answer"])
        else:
            st.success(_md(result["answer"]))
            names = {h["fabric_id"]: h["fabric_name"] for h in result["chunks"]}
            label = "Source" if len(result["sources"]) == 1 else "Sources"
            st.markdown(f"**{label}:** " + ", ".join(f"`{i}` ({names[i]})" if i in names else f"`{i}`"
                                                    for i in result["sources"]))
        if result["note"]:
            st.info(result["note"])
        if result["chunks"]:
            with st.expander("Show the spec text this answer is based on"):
                for h in result["chunks"]:
                    st.markdown(f"**{h['fabric_id']}** \u00b7 {h['section']} \u00b7 match {h['score']}")
                    st.caption(_md(h["text"]))
    st.divider()
    st.caption("Sample data only: these are not real Indus Weaves specifications.")


