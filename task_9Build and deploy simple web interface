def _hit(fabric_id, name, section, text, score):
    return {"rank": 1, "score": score, "chunk_id": f"{fabric_id}::{section}", "fabric_id": fabric_id,
            "fabric_name": name, "category": "x", "section": section, "text": text}


LINEN_CARE = _hit("IW-FAB-015", "Cotton-Linen Blend 55/45", "care",
                  "Cotton-Linen Blend 55/45 (IW-FAB-015) care instructions: Machine wash cold (30°C max); "
                  "Do not bleach; Line dry in shade; Iron high heat. Notes: Creases less than pure linen.", 0.62)
LINEN_PLAIN_CARE = _hit("IW-FAB-014", "Linen Plain Weave", "care",
                        "Linen Plain Weave (IW-FAB-014) care instructions: Machine wash warm (40°C max); Do not bleach.", 0.40)
